# setu-catalog-server: build from the setu repo's root
#   podman build -f packages/setu-catalog-server/Containerfile -t setu-catalog .
# Everything it keeps is under /data: mount a volume there and back it up.
FROM python:3.12-slim
RUN pip install --no-cache-dir uv
WORKDIR /src
COPY packages/setu /src/packages/setu
COPY packages/setu-catalog-server /src/packages/setu-catalog-server
RUN uv pip install --system --no-cache /src/packages/setu /src/packages/setu-catalog-server
RUN useradd --system --home /data catalog && mkdir -p /data && chown catalog /data
USER catalog
VOLUME /data
EXPOSE 8780
ENV SETU_CATALOG_DATA=/data
# TLS belongs to whatever is in front (Caddy, nginx, the host's load
# balancer); with one in front, add --behind-proxy so installs are counted
# per real address rather than per proxy.
CMD ["setu-catalog-server", "--host", "0.0.0.0", "--port", "8780"]
